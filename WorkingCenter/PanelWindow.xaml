<Window x:Class="WorkingCenter.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorkingCenter.Views"
        Title="Hive Station" Width="360" Height="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" Topmost="True">
    <!-- AllowsTransparency=True gives the smoothest slide animation (the Card
         translates inside a transparent window; no HWND repaint, no grey block).
         Fluent-style light rounded Card sits on top. Mica/Acrylic would require
         AllowsTransparency=False and cost animation smoothness — we chose fluid. -->
    <Border x:Name="Card" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" X="0" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: title on the left, action buttons docked to the far right -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Image Source="bee.png" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="Hive Station" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="你的轻量工作台" FontSize="11" Foreground="{DynamicResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinBtn" Style="{StaticResource PinHeaderBtn}" Click="PinBtn_Click"
                                ToolTip="固定展开（固定后不自动收起）">
                            <Path Data="{StaticResource PinGlyph}" Fill="{DynamicResource Ink}"
                                  Stretch="Uniform" Width="13" Height="13"/>
                        </Button>
                        <Button x:Name="SettingsBtn" Style="{StaticResource HeaderBtn}" Click="SettingsBtn_Click"
                                ToolTip="设置" Margin="2,0,0,0">
                            <Path x:Name="SettingsIcon" Data="{StaticResource SettingsGlyph}" Fill="{DynamicResource Ink}"
                                  Stretch="Uniform" Width="15" Height="15"/>
                        </Button>
                        <Button x:Name="HideBtn" Style="{StaticResource HeaderBtn}" Click="HideBtn_Click"
                                ToolTip="隐藏到托盘（程序仍在运行）" Margin="2,0,0,0">
                            <Path Data="{StaticResource CloseGlyph}" Fill="{DynamicResource Ink}"
                                  Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Work / Settings views share Row 1; visibility bound to CurrentView -->
            <Grid Grid.Row="1">
                <local:Workspace x:Name="WorkspaceHost"
                        Visibility="{Binding CurrentView, Converter={StaticResource BoolToVis}, ConverterParameter=work}"/>
                <local:SettingsView x:Name="SettingsHost"
                        Visibility="{Binding CurrentView, Converter={StaticResource BoolToVis}, ConverterParameter=settings}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
