<UserControl x:Class="WorkingCenter.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkingCenter.ViewModels"
             xmlns:core="clr-namespace:WorkingCenter.Core"
             FontFamily="Segoe UI, Microsoft YaHei"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,8">
        <StackPanel>

            <!-- 1. 主题 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="主题" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LightRadio" Content="浅色" Style="{StaticResource Radio}" GroupName="Theme"
                                     Command="{Binding SetThemeLightCommand}"/>
                        <RadioButton x:Name="DarkRadio" Content="深色" Style="{StaticResource Radio}" GroupName="Theme"
                                     Command="{Binding SetThemeDarkCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. 开机自启 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="开机自启" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <!-- "是"绑定 AutoStartEnabled(IsChecked 双向默认)；"否"同组互斥，
                             勾"否"会反推绑定把 false 写回 setter（写注册表） -->
                        <RadioButton Content="是" Style="{StaticResource Radio}" GroupName="AutoStart"
                                     IsChecked="{Binding AutoStartEnabled}"/>
                        <RadioButton Content="否" Style="{StaticResource Radio}" GroupName="AutoStart"
                                     IsChecked="{Binding AutoStartEnabled, Converter={StaticResource InvertBool}}"/>
                    </StackPanel>
                    <!-- inline red error (registry blocked etc.), no popup -->
                    <TextBlock Text="{Binding AutoStartError}" FontSize="11" Foreground="{DynamicResource Danger}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding AutoStartError, Converter={StaticResource NonEmptyToVis}}"/>
                </StackPanel>
            </Border>

            <!-- 3. 固定位置 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="固定位置" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="EdgeLeft" Content="屏幕最左边" Style="{StaticResource Radio}" GroupName="Edge"
                                     Command="{Binding SetEdgeLeftCommand}"/>
                        <RadioButton x:Name="EdgeRight" Content="屏幕最右边" Style="{StaticResource Radio}" GroupName="Edge"
                                     Command="{Binding SetEdgeRightCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 项目管理 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="项目管理" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding ProjectList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectViewModel}">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Ink}"/>
                                        <!-- hover to reveal the icon actions, same interaction
                                             as the todo rows: up/down to reorder, edit, delete -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource ActBtn}" Click="ProjectUp_Click" Tag="{Binding Id}" ToolTip="上移">
                                                <Path Data="{StaticResource UpIcon}" Stroke="{DynamicResource Muted}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource ActBtn}" Margin="2,0,0,0" Click="ProjectDown_Click" Tag="{Binding Id}" ToolTip="下移">
                                                <Path Data="{StaticResource DownIcon}" Stroke="{DynamicResource Muted}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource ActBtn}" Margin="2,0,0,0" Click="Rename_Click" Tag="{Binding Id}" ToolTip="改名">
                                                <Path Data="{StaticResource EditIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                            <Button Style="{StaticResource ActBtn}" Margin="2,0,0,0" Click="Delete_Click" Tag="{Binding Id}" ToolTip="删除">
                                                <Path Data="{StaticResource DeleteIcon}" Stroke="{DynamicResource Danger}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- inline rename row (no popup) -->
                                    <Border Visibility="{Binding IsRenameMode, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource DetailBg}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                                                     x:Name="RenameBox" Style="{StaticResource Input}" Padding="8,6" FontSize="13"
                                                     KeyDown="RenameBox_KeyDown" Tag="{Binding Id}"/>
                                            <!-- inline validation error (empty / duplicate name), no popup -->
                                            <TextBlock Text="{Binding EditError}" FontSize="11" Foreground="{DynamicResource Danger}"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding EditError, Converter={StaticResource NonEmptyToVis}}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                <Button Content="取消" Click="CancelProj_Click" Tag="{Binding Id}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                                <Button Content="保存" Click="SaveRename_Click" Tag="{Binding Id}" Style="{StaticResource AccentButton}" Padding="10,4" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- inline delete-confirm row (no popup). If the project
                                         has tasks, also offers a target-project picker. -->
                                    <Border Visibility="{Binding IsDeleteConfirm, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource DangerSoftBg}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                            BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="确定删除该项目？" FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"
                                                       Visibility="{Binding HasMoveTargets, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                            <!-- inline red blocked-delete / missing-target hint (no popup) -->
                                            <TextBlock Text="{Binding DeleteBlockedMessage}" FontSize="11" Foreground="{DynamicResource Danger}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                                       Visibility="{Binding DeleteBlockedMessage, Converter={StaticResource NonEmptyToVis}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                        Visibility="{Binding HasMoveTargets, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="待办转移到：" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,6,0"/>
                                                <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding MoveTargets}" SelectedItem="{Binding MoveTarget}"
                                                          DisplayMemberPath="Name" MinWidth="100" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="取消" Click="CancelProj_Click" Tag="{Binding Id}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                                <Button Content="确认删除" Click="ConfirmDelete_Click" Tag="{Binding Id}" Style="{StaticResource DangerSolidButton}" Padding="10,4" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewProjName" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource Input}" Height="32" FontSize="13"
                                     KeyDown="NewProjName_KeyDown" ToolTip="新项目名称，回车添加"/>
                            <Button Grid.Column="1" Content="添加项目" Click="AddProj_Click" Style="{StaticResource AccentButton}" Height="32"/>
                        </Grid>
                        <TextBlock Text="{Binding AddProjectError}" FontSize="11" Foreground="{DynamicResource Danger}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding AddProjectError, Converter={StaticResource NonEmptyToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. 数据管理 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="数据管理" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="导出 JSON" Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="1" Content="导入 JSON" Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Center"/>
                        <Button Grid.Column="2" Content="清除全部" Command="{Binding ClearCommand}" Style="{StaticResource AccentButton}"/>
                    </Grid>
                    <!-- inline green notice (import/export success), no popup -->
                    <Border Visibility="{Binding DataNotice, Converter={StaticResource NonEmptyToVis}}"
                            Background="{DynamicResource SuccessSoftBg}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                            BorderBrush="{DynamicResource Done}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding DataNotice}" FontSize="12" Foreground="{DynamicResource Done}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="好的" Command="{Binding DismissDataNoticeCommand}" Style="{StaticResource SuccessSolidButton}"
                                    Padding="10,4" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <!-- inline red error notice (import/export failure), no popup -->
                    <Border Visibility="{Binding DataError, Converter={StaticResource NonEmptyToVis}}"
                            Background="{DynamicResource DangerSoftBg}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                            BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding DataError}" FontSize="12" Foreground="{DynamicResource Danger}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="好的" Command="{Binding DismissDataNoticeCommand}" Style="{StaticResource DangerSolidButton}"
                                    Padding="10,4" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <!-- inline clear confirm (was a popup), mirrors task delete -->
                    <Border Visibility="{Binding IsClearConfirm, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource DangerSoftBg}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                            BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="确定清除全部待办和随手记吗？项目会保留。此操作不可撤销。" FontSize="12"
                                       Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Command="{Binding CancelClearCommand}" Style="{StaticResource SecondaryButton}"
                                        Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="确认清除" Command="{Binding ConfirmClearCommand}" Style="{StaticResource DangerSolidButton}"
                                        Padding="10,4" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
