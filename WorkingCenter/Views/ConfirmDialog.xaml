<Window x:Class="WorkingCenter.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hive Station"
        Width="360" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#1f2430"/>
        <TextBlock x:Name="MsgText" Grid.Row="1" TextWrapping="Wrap" FontSize="13" Foreground="#1f2430" Margin="0,0,0,8"/>
        <StackPanel x:Name="ChoicePanel" Grid.Row="2" Orientation="Vertical" Margin="0,0,0,8" Visibility="Collapsed">
            <ComboBox x:Name="ChoiceBox" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBox x:Name="InputBox" Grid.Row="2" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,8"
                 Visibility="Collapsed" BorderBrush="#e6e8eb" BorderThickness="1" Padding="6,4" CaretBrush="#f5a623"
                 KeyDown="InputBox_KeyDown"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="OkBtn" Content="确定" Click="Ok_Click" MinWidth="64" Margin="0,0,8,0"
                    Padding="10,4" Background="#f5a623" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="CancelBtn" Content="取消" Click="Cancel_Click" MinWidth="64"
                    Padding="10,4" Background="Transparent" Foreground="#6b7280" BorderBrush="#e6e8eb" BorderThickness="1" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
