<UserControl x:Class="WorkingCenter.Views.Workspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkingCenter.ViewModels"
             FontFamily="Segoe UI, Microsoft YaHei"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:TodoTaskViewModel}">
            <!-- A task row (display vs edit) with an inline detail region below it.
                 Detail is a Markdown-quote-block style area: left thin bar, low-
                 contrast background, multi-line editable text, auto-saved. -->
            <StackPanel>
                <Border Padding="8,7" CornerRadius="6">
                <Grid>
                    <!-- DISPLAY MODE -->
                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UrgentBg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border Grid.ColumnSpan="3" Width="3" HorizontalAlignment="Left" Background="{DynamicResource UrgentBar}"
                                Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVis}}"/>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" Style="{StaticResource Check}" VerticalAlignment="Center"
                                  Margin="6,0,8,0" Focusable="False"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="6,0,8,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,4,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- show action buttons only while the row is hovered -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource ActBtn}" Command="{Binding BeginEditCommand}" ToolTip="修改">
                                <Path Data="{StaticResource EditIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                            <Button Margin="2,0,0,0" Command="{Binding ToggleUrgentCommand}" ToolTip="加急">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActBtn}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource UrgentBg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="{StaticResource UrgentIcon}" Stroke="#F5A623" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                            <Button Margin="2,0,0,0" Command="{Binding ToggleDetailCommand}" ToolTip="详情">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActBtn}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDetailOpen}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="{StaticResource DetailIcon}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                            <Button Style="{StaticResource ActBtn}" Margin="2,0,0,0" Command="{Binding DeleteCommand}" ToolTip="删除">
                                <Path Data="{StaticResource DeleteIcon}" Stroke="{DynamicResource Danger}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- EDIT MODE -->
                    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" IsEnabled="False" Style="{StaticResource Check}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                        <TextBox Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" Style="{StaticResource Input}"
                                 Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                                 vm:FocusBehavior.IsFocused="{Binding IsEditing}"
                                 vm:ImeBehavior.SubmitCommand="{Binding CommitEditCommand}"
                                 vm:ImeBehavior.CancelCommand="{Binding CancelEditCommand}"
                                 LostFocus="EditBox_LostFocus"/>
                        <Button Grid.Column="2" Style="{StaticResource ActBtn}" Command="{Binding CommitEditCommand}" ToolTip="保存">
                            <Path Data="{StaticResource CheckIcon}" Stroke="#16a34a" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                </Grid>
                </Border>

                <!-- DETAIL REGION (inline, quote-block style, auto-saved) -->
                <Border Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}"
                        BorderBrush="{DynamicResource DetailBar}" BorderThickness="3,0,0,0" Background="{DynamicResource DetailBg}"
                        Margin="20,2,8,4" Padding="10,8" CornerRadius="0,6,6,0">
                    <StackPanel>
                        <TextBox Text="{Binding Detail, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlainTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 FontSize="12" MinHeight="36"
                                 ToolTip="记录背景、待确认问题、思路、临时数据…自动保存"/>
                        <TextBlock Text="{Binding DetailStatus}" FontSize="10" Foreground="{DynamicResource Faint}"
                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- inline delete-confirm row (no popup) -->
                <Border Visibility="{Binding IsDeleteConfirm, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource DangerSoftBg}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0"
                        BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="确定删除该任务？" FontSize="12" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Command="{Binding CancelDeleteCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                            <Button Content="确认删除" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource DangerSolidButton}" Padding="10,4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,8">
        <StackPanel>
            <!-- Quick Notes card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="📝 随手记 / Quick Notes" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Text="{Binding SaveStatus}" FontSize="11" Foreground="{DynamicResource Faint}"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox Style="{StaticResource MultiInput}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             Text="{Binding NoteContent, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="想到什么就写什么，自动保存…"
                             GotFocus="Notes_GotFocus" LostFocus="Notes_LostFocus"/>
                </StackPanel>
            </Border>

            <!-- To-Do card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="✅ 今日待办 / To-Do" Style="{StaticResource SectionLabel}"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Style="{StaticResource Combo}" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                  DisplayMemberPath="Name" MinWidth="64" Width="72" MinHeight="34" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource Input}" MinHeight="34" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 vm:ImeBehavior.SubmitCommand="{Binding AddTaskCommand}"
                                 GotFocus="AddInput_GotFocus" LostFocus="AddInput_LostFocus"
                                 ToolTip="加一项任务，回车也行…"/>
                        <Button Grid.Column="2" Style="{StaticResource AccentButton}" MinHeight="34" VerticalAlignment="Center"
                                Content="添加" Command="{Binding AddTaskCommand}"/>
                    </Grid>

                    <!-- Grouped overview -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectGroupViewModel}">
                                <StackPanel Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <Ellipse Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HeaderLabel}" FontWeight="Bold" FontSize="13" Margin="8,0,0,0" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有任务，加一个吧。" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"
                               Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
