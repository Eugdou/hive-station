<Window x:Class="WorkingCenter.HandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="18" Height="360"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    <Grid>
        <!-- Small, low-key vertical accent bar near the screen edge.
             The window is 18px wide (forgiving hotzone) but the visible bar is
             a thin 4px line hugging the edge so it stays discreet. -->
        <Rectangle Width="4" HorizontalAlignment="Right" Margin="0,0,2,0" RadiusX="2" RadiusY="2" Fill="#f5a623" Opacity="0.85"/>
    </Grid>
</Window>
